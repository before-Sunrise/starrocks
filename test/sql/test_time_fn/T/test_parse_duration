-- name: test_parse_duration
select parse_duration('123ns');
-- result:
0.000000123
-- !result

select parse_duration('123us');
-- result:
0.000123
-- !result

select parse_duration('123ms');
-- result:
0.123
-- !result

select parse_duration('123s');
-- result:
123
-- !result

select parse_duration('10m');
-- result:
600
-- !result

select parse_duration('1.5h');
-- result:
5400
-- !result

select parse_duration('2d');
-- result:
172800
-- !result

-- test with spaces
select parse_duration(' 123 ms ');
-- result:
0.123
-- !result

select parse_duration('2.5  h');
-- result:
9000
-- !result

-- test decimals and scientific notation
select parse_duration('0.5s');
-- result:
0.5
-- !result

select parse_duration('1e-3s');
-- result:
0.001
-- !result

-- test invalid formats
select parse_duration('123');
-- result:
NULL
-- !result

select parse_duration('ms');
-- result:
NULL
-- !result

select parse_duration('123xx');
-- result:
NULL
-- !result

select parse_duration('');
-- result:
NULL
-- !result

select parse_duration(NULL);
-- result:
NULL
-- !result

-- test with constants vs non-constants
CREATE TABLE duration_test (
  d_str VARCHAR(64)
) DISTRIBUTED BY HASH(d_str) PROPERTIES("replication_num" = "1");

INSERT INTO duration_test VALUES ('100ms'), ('1s'), ('1.5h'), ('invalid'), (NULL);

select d_str, parse_duration(d_str) from duration_test order by d_str;
-- result:
NULL	NULL
1.5h	5400
100ms	0.1
1s	1
invalid	NULL
-- !result
